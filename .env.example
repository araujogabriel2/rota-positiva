# Copie este arquivo para .env e preencha somente no seu computador.
# Nunca envie o arquivo .env ao GitHub.
DATABASE_URL=postgresql://postgres.seu-projeto:[YOUR-PASSWORD]@seu-host:5432/postgres
DATABASE_PASSWORD=sua-senha-do-banco
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
ADMIN_USERNAME=admin
MAX_USERS=5
SESSION_COOKIE_SECURE=false
